# App Configuration
APP_NAME="Askara"
APP_VERSION="1.0.0"

# Authentication (Required for auth.py)
SECRET_KEY="your-super-secret-key-change-this-in-production-please-use-a-strong-key"
ALGORITHM="HS512"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Settings
FILE_ALLOWED_EXTENSIONS=["text/plain","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10  # MB
FILE_DEFAULT_CHUNK_SIZE=512000  # 512 KB (fixed typo)

# LLM Providers (for Bonus 1 - LLM Factory)
PROVIDER="mock"  # Options: mock, openai, gemini, ollama
OPENAI_API_KEY="your_openai_key_here"
GEMINI_API_KEY="your_gemini_key_here"
OLLAMA_URL="http://localhost:11434"

# RAG Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
DEFAULT_TEMPERATURE=0.7
DEFAULT_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Data Directory
DATA_DIRECTORY="/home/marwaahmed/rag-project/RAG/data/orgin_doc"