APP_NAME="mini-RAG"
APP_VERSION="0.1"
OPENAI_API_KEY=""

# ── LLM Configuration ────────────────────────────────────────
LLM_PROVIDER=ollama           # Options: ollama, openai, gemini
LLM_MODEL=mistral             # Model name for chosen provider

# ── API Keys (fill in based on LLM_PROVIDER) ─────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Vector Database ───────────────────────────────────────────
VECTOR_DB=chromadb
CHROMA_HOST=chromadb          # Must match service name in compose
CHROMA_PORT=8000

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
