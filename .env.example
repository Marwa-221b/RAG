# App Configuration
APP_NAME="Askara"
APP_VERSION="1.0.0"

# Authentication (change SECRET_KEY in production!)
SECRET_KEY="change-this-to-a-strong-random-key-in-production"
ALGORITHM="HS512"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Settings
FILE_ALLOWED_EXTENSIONS=["text/plain","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# LLM Providers (set PROVIDER to: ollama, openai, or gemini)
PROVIDER="ollama"
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.2"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# RAG Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
DEFAULT_TEMPERATURE=0.7
DEFAULT_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Data Directory
DATA_DIRECTORY="/app/data/orgin_doc"
DATA_PATH=/app/data